{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAVYLAB WeChat Content Package",
  "description": "Unified draft-only manifest for article, image post, video and podcast.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "brand", "content_type", "title", "author", "digest",
    "column", "body_file", "sources_file", "review_file", "status",
    "review_blockers", "publish_mode", "human_approval_required",
    "auto_publish_allowed", "assets", "metadata"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "2.0" },
    "brand": { "const": "DAVYLAB" },
    "tagline": { "type": "string" },
    "content_type": { "enum": ["article", "image_post", "video", "podcast"] },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "digest": { "type": "string" },
    "column": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "body_file": { "type": "string" },
    "sources_file": { "type": "string" },
    "review_file": { "type": "string" },
    "status": {
      "enum": [
        "draft-prepared", "ready-for-workbuddy", "draft-saved-in-wechat",
        "human-reviewed", "published-by-human", "blocked"
      ]
    },
    "review_blockers": { "type": "array", "items": { "type": "string" } },
    "publish_mode": { "const": "save_draft_only" },
    "human_approval_required": { "const": true },
    "auto_publish_allowed": { "const": false },
    "created_date": { "type": "string" },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover", "images", "video", "audio", "transcript_file", "subtitles_file"],
      "properties": {
        "cover": { "$ref": "#/$defs/assetOrEmpty" },
        "images": { "type": "array", "items": { "$ref": "#/$defs/imageAsset" } },
        "video": { "$ref": "#/$defs/mediaAsset" },
        "audio": { "$ref": "#/$defs/mediaAsset" },
        "transcript_file": { "type": "string" },
        "subtitles_file": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_post", "video", "podcast"],
      "properties": {
        "image_post": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order_reviewed"],
          "properties": { "order_reviewed": { "type": "boolean" } }
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "script_file": { "type": "string" },
            "thumbnail_path": { "type": "string" },
            "subtitle_language": { "type": "string" }
          }
        },
        "podcast": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "episode_number": { "type": "string" },
            "host": { "type": "string" },
            "guest": { "type": "string" },
            "show_notes_file": { "type": "string" },
            "transcript_file": { "type": "string" }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "assetOrEmpty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "url": { "type": "string" },
        "duration_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "aspect_ratio": { "type": "string" }
      }
    },
    "mediaAsset": {
      "allOf": [
        { "$ref": "#/$defs/assetOrEmpty" },
        {
          "type": "object",
          "properties": {
            "duration_seconds": { "type": ["integer", "null"], "minimum": 0 },
            "aspect_ratio": { "type": "string" }
          }
        }
      ]
    },
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "caption", "alt"],
      "properties": {
        "path": { "type": "string" },
        "url": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "caption": { "type": "string" },
        "alt": { "type": "string" }
      },
      "anyOf": [
        { "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
        { "required": ["url"], "properties": { "url": { "type": "string", "pattern": "^https://" } } }
      ]
    }
  }
}